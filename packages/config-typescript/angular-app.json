{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "Para las aplicaciones Angular (apps/console, apps/public-web).",
  "extends": "./base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "declaration": false,
    "declarationMap": false
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "_declaration": "Las APLICACIONES no emiten .d.ts. Con `declaration: true`, TypeScript infiere un rootDir en la carpeta de la app y falla al importar código de libs/ (TS6059). Las librerías sí lo activan, en angular-lib.json."
}
