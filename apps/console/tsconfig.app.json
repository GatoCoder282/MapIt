{
  "extends": "../../packages/config-typescript/angular-app.json",
  "_generatedClient": "El cliente OpenAPI genera imports comunes que no todas las operaciones usan; la calidad del codigo propio sigue cubierta por ESLint.",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/console",
    "rootDir": "../..",
    "types": [],
    "noUnusedLocals": false,
    "paths": {
      "@mapit/ui-kit": ["../../libs/ui-kit/src/index.ts"],
      "@mapit/api-client": ["../../libs/api-client/src/index.ts"],
      "@mapit/auth": ["../../libs/auth/src/index.ts"],
      "@mapit/feature-flags": ["../../libs/feature-flags/src/index.ts"],
      "@mapit/realtime": ["../../libs/realtime/src/index.ts"],
      "@mapit/map-engine": ["../../libs/map-engine/src/index.ts"]
    }
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.d.ts"],
  "_rootDir": "Las apps importan de libs/, fuera de su carpeta. Sin rootDir explícito TypeScript lo infiere en apps/<app> y falla con TS6059."
}
