# =============================================================
#  MapIt — variables de entorno
#  Copia este archivo a `.env` (`pnpm setup` lo hace por ti).
#  NUNCA commitees `.env`.
# =============================================================

# ── Entorno ──────────────────────────────────────────────────
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev
COMPOSE_PROJECT_NAME=mapit
APP_ENV=development
LOG_LEVEL=INFO
MAPIT_LOG_LEVEL=INFO

# ── Base de datos ────────────────────────────────────────────
POSTGRES_DB=mapit
POSTGRES_USER=mapit
POSTGRES_PASSWORD=changeme_local
# 5433 en vez de 5432: evita chocar con un PostgreSQL instalado nativamente.
# Es el puerto en TU máquina; dentro de Docker el contenedor sigue usando 5432.
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
DB_URL=jdbc:postgresql://localhost:5433/mapit
# Credenciales del rol de RUNTIME (NOSUPERUSER, NOBYPASSRLS).
# Lo crea/actualiza la migración V7. `mapit` queda solo para Flyway.
MAPIT_APP_DB_USER=mapit_app
MAPIT_APP_DB_PASSWORD=changeme_local

# ── Backend ──────────────────────────────────────────────────
BACKEND_PORT=8080
API_BASE_URL=http://localhost:8080/api/v1
WS_URL=ws://localhost:8080/ws

# ── Seguridad (JWT) ──────────────────────────────────────────
# Mínimo 32 caracteres. En despliegue: generar uno nuevo y secreto.
JWT_SECRET=dev_only_change_me_min_32_chars_long_0123456789
JWT_ISSUER=mapit
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300

# ── Multi-tenant ─────────────────────────────────────────────
# El tenant se resuelve del claim `tenant` del JWT (rutas de staff).
# TENANT_DEFAULT es el fallback solo para contextos sin JWT (demo pública).
TENANT_DEFAULT=demo

# ── Feature flags (Unleash) ──────────────────────────────────
# false = el backend usa los defaults del catálogo (FeatureFlag) sin hablar con Unleash.
UNLEASH_ENABLED=true
UNLEASH_PORT=4242
UNLEASH_URL=http://localhost:4242/api
# Token de CLIENTE: lo usan el backend y el proxy para leer flags.
# Formato obligatorio: <proyecto>:<entorno>.<secreto>
UNLEASH_API_TOKEN=default:development.unleash-insecure-api-token
# Token de ADMIN: para la API de administración. Debe ser de alcance global (*:*).
UNLEASH_ADMIN_TOKEN=*:*.unleash-insecure-admin-token
UNLEASH_APP_NAME=mapit-backend
UNLEASH_ENVIRONMENT=development
UNLEASH_ADMIN_USER=admin
UNLEASH_ADMIN_PASSWORD=unleash4all
# El frontend NUNCA habla directo con Unleash: pasa por el proxy.
# Ojo, son dos secretos distintos:
#  - UNLEASH_API_TOKEN  = con qué se autentica el proxy CONTRA Unleash (formato Unleash).
#  - UNLEASH_PROXY_CLIENT_KEY = con qué se autentica el NAVEGADOR contra el proxy
#    (secreto libre; es público por naturaleza, por eso nunca se expone el de arriba).
UNLEASH_PROXY_PORT=3063
UNLEASH_PROXY_URL=http://localhost:3063/proxy
UNLEASH_PROXY_CLIENT_KEY=dev-proxy-key-change-me

# ── Frontends ────────────────────────────────────────────────
CONSOLE_PORT=4200
PUBLIC_WEB_PORT=4300
# Base pública de public-web: enlaces de los correos (activación, historial) y,
# en el build desplegado, el origen de los QR de pago de console.
PUBLIC_WEB_URL=http://localhost:4300

# ── Build de frontends desplegados (Vercel) ──────────────────
# Solo los lee tools/scripts/frontend-config.mjs al generar config.json; en local
# las apps usan public/assets/config.json. En Vercel todas las URL deben ser https/wss
# y se definen por entorno (Production / Preview). Ver docs/deployment/README.md.
CONSOLE_BASE_URL=http://localhost:4200
# Frontend API de Unleash (https://<unleash>/api/frontend) y su token de tipo frontend.
# Vacías = flags fijos en los defaults del catálogo. Nunca un token admin ni de cliente.
UNLEASH_FRONTEND_URL=
UNLEASH_FRONTEND_TOKEN=

# ── Pagos QR (CU-17) — pendiente de elegir pasarela ──────────
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── SUPER_ADMIN de plataforma (tenant técnico `platform`) ──
# Lo crea el backend al arrancar si no existe. Nunca en Flyway.
# Sin contraseña configurada, la cuenta no se crea y solo queda un aviso en el log.
SUPER_ADMIN_EMAIL=superadmin@mapit.local
SUPER_ADMIN_FULL_NAME=Super Administrador
SUPER_ADMIN_PASSWORD=super-admin-dev

# ── Correo (dev: Mailpit captura todo, no envía nada) ────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_UI_PORT=8025
# En despliegues el proveedor exige un remitente verificado.
MAIL_FROM=no-reply@mapit.local
# Mailpit no pide auth ni TLS. Desplegado (Render free bloquea 25/465/587):
# puerto 2525 con MAIL_SMTP_AUTH=true y MAIL_SMTP_STARTTLS=true.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
# Timeouts en ms: el alta de empresa envía el correo dentro de su transacción.
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000

# ── Historial de reservas del cliente (HU-6.04) ──────────────
CUSTOMER_HISTORY_LINK_TTL_MINUTES=15
CUSTOMER_HISTORY_SESSION_TTL_MINUTES=30
CUSTOMER_HISTORY_WINDOW_MINUTES=15
CUSTOMER_HISTORY_PERSON_LIMIT=3
CUSTOMER_HISTORY_IP_LIMIT=10

# ── Tiempo real (outbox de eventos STOMP) ────────────────────
REALTIME_OUTBOX_POLL_MS=250
REALTIME_OUTBOX_BATCH_SIZE=50
REALTIME_OUTBOX_RETENTION_DAYS=7
REALTIME_OUTBOX_CLEANUP_MS=3600000

# ── Herramientas opcionales (perfil `tools`) ─────────────────
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=
SONAR_PORT=9000
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@mapit.local
PGADMIN_PASSWORD=admin
PRISM_PORT=4010

# Notificaciones: retención lógica; purga física opt-in, nunca elimina claves de deduplicación.
MAPIT_NOTIFICATIONS_RETENTION_DAYS=30
MAPIT_NOTIFICATIONS_CLEANUP_ENABLED=false
MAPIT_NOTIFICATIONS_CLEANUP_INTERVAL_MS=3600000

# Dos fases por tenant: hechos durables y señales de versiones ya confirmadas.
MAPIT_NOTIFICATIONS_DELIVERY_INTERVAL_MS=1000
