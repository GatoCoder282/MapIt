# =============================================================
#  MapIt — variables de entorno
#  Copia este archivo a `.env` (`pnpm setup` lo hace por ti).
#  NUNCA commitees `.env`.
# =============================================================

# ── Entorno ──────────────────────────────────────────────────
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev
COMPOSE_PROJECT_NAME=mapit

# ── Base de datos ────────────────────────────────────────────
POSTGRES_DB=mapit
POSTGRES_USER=mapit
POSTGRES_PASSWORD=changeme_local
# 5433 en vez de 5432: evita chocar con un PostgreSQL instalado nativamente.
# Es el puerto en TU máquina; dentro de Docker el contenedor sigue usando 5432.
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
DB_URL=jdbc:postgresql://localhost:5433/mapit

# ── Backend ──────────────────────────────────────────────────
BACKEND_PORT=8080
API_BASE_URL=http://localhost:8080/api/v1
WS_URL=ws://localhost:8080/ws

# ── Seguridad (JWT) ──────────────────────────────────────────
# Mínimo 32 caracteres. En despliegue: generar uno nuevo y secreto.
JWT_SECRET=dev_only_change_me_min_32_chars_long_0123456789
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300

# ── Multi-tenant ─────────────────────────────────────────────
# El tenant se resuelve del claim `tenant` del JWT (rutas de staff).
# El header es solo fallback para rutas públicas.
TENANT_RESOLUTION_STRATEGY=jwt-claim
TENANT_HEADER_NAME=X-Tenant-Id
TENANT_DEFAULT=demo

# ── Feature flags (Unleash) ──────────────────────────────────
UNLEASH_PORT=4242
UNLEASH_URL=http://localhost:4242/api
# Token de CLIENTE: lo usan el backend y el proxy para leer flags.
# Formato obligatorio: <proyecto>:<entorno>.<secreto>
UNLEASH_API_TOKEN=default:development.unleash-insecure-api-token
# Token de ADMIN: para la API de administración. Debe ser de alcance global (*:*).
UNLEASH_ADMIN_TOKEN=*:*.unleash-insecure-admin-token
UNLEASH_APP_NAME=mapit-backend
UNLEASH_ENVIRONMENT=development
UNLEASH_ADMIN_USER=admin
UNLEASH_ADMIN_PASSWORD=unleash4all
# El frontend NUNCA habla directo con Unleash: pasa por el proxy.
# Ojo, son dos secretos distintos:
#  - UNLEASH_API_TOKEN  = con qué se autentica el proxy CONTRA Unleash (formato Unleash).
#  - UNLEASH_PROXY_CLIENT_KEY = con qué se autentica el NAVEGADOR contra el proxy
#    (secreto libre; es público por naturaleza, por eso nunca se expone el de arriba).
UNLEASH_PROXY_PORT=3063
UNLEASH_PROXY_URL=http://localhost:3063/proxy
UNLEASH_PROXY_CLIENT_KEY=dev-proxy-key-change-me

# ── Frontends ────────────────────────────────────────────────
CONSOLE_PORT=4200
PUBLIC_WEB_PORT=4300

# ── Pagos QR (CU-17) — pendiente de elegir pasarela ──────────
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── Correo (dev: Mailpit captura todo, no envía nada) ────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_UI_PORT=8025

# ── Herramientas opcionales (perfil `tools`) ─────────────────
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=
SONAR_PORT=9000
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@mapit.local
PGADMIN_PASSWORD=admin
PRISM_PORT=4010
