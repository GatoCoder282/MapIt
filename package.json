{
  "name": "mapit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MapIt — Mapea tu negocio, opéralo en tiempo real.",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "//── DIARIO ─────────────────────────────────────────": "",
    "setup": "node tools/scripts/setup.mjs",
    "dev": "node tools/scripts/dev.mjs all",
    "dev:front": "node tools/scripts/dev.mjs front",
    "dev:back": "node tools/scripts/dev.mjs back",
    "check": "node tools/scripts/check.mjs",
    "stop": "node tools/scripts/compose.mjs down",
    "//── INFRA ──────────────────────────────────────────": "",
    "infra:up": "node tools/scripts/compose.mjs up",
    "infra:down": "node tools/scripts/compose.mjs down",
    "infra:logs": "node tools/scripts/compose.mjs logs",
    "infra:ps": "node tools/scripts/compose.mjs ps",
    "infra:reset": "node tools/scripts/compose.mjs reset",
    "infra:tools": "node tools/scripts/compose.mjs tools",
    "infra:full": "node tools/scripts/compose.mjs full",
    "//── BACKEND ────────────────────────────────────────": "",
    "be:run": "node tools/scripts/gradle.mjs bootRun",
    "be:test": "node tools/scripts/gradle.mjs test",
    "be:it": "node tools/scripts/gradle.mjs integrationTest",
    "be:build": "node tools/scripts/gradle.mjs build",
    "be:lint": "node tools/scripts/gradle.mjs spotlessCheck",
    "be:fmt": "node tools/scripts/gradle.mjs spotlessApply",
    "be:image": "node tools/scripts/gradle.mjs :bootstrap:bootBuildImage",
    "be:clean": "node tools/scripts/gradle.mjs clean",
    "//── FRONTEND ───────────────────────────────────────": "",
    "fe:console": "ng serve console",
    "fe:public": "ng serve public-web",
    "fe:test": "ng test console && ng test public-web && ng test libs",
    "fe:test:watch": "ng test console --watch",
    "fe:build": "ng build console && ng build public-web",
    "fe:lint": "eslint apps libs packages tools --max-warnings=0",
    "fe:typecheck": "tsc -p apps/console/tsconfig.app.json --noEmit && tsc -p apps/public-web/tsconfig.app.json --noEmit",
    "//── BASE DE DATOS ──────────────────────────────────": "",
    "db:migrate": "node tools/scripts/gradle.mjs :bootstrap:flywayMigrate",
    "db:info": "node tools/scripts/gradle.mjs :bootstrap:flywayInfo",
    "db:new": "node tools/scripts/new-migration.mjs",
    "db:seed": "node tools/scripts/db-seed.mjs",
    "db:seed:flags": "node tools/scripts/seed-flags.mjs",
    "db:erd": "node tools/scripts/db-erd.mjs",
    "//── CONTRATO API ───────────────────────────────────": "",
    "api:gen": "node tools/scripts/gen-api.mjs",
    "api:check": "node tools/scripts/gen-api.mjs --check",
    "api:lint": "pnpm --filter @mapit/api-contract run lint",
    "api:mock": "node tools/scripts/compose.mjs mock",
    "//── CALIDAD Y E2E ──────────────────────────────────": "",
    "e2e": "pnpm --filter @mapit/e2e run test",
    "e2e:ui": "pnpm --filter @mapit/e2e run test:ui",
    "e2e:report": "pnpm --filter @mapit/e2e run report",
    "e2e:install": "pnpm --filter @mapit/e2e exec playwright install --with-deps",
    "sonar": "node tools/scripts/sonar.mjs",
    "fmt": "prettier --write . && node tools/scripts/gradle.mjs spotlessApply",
    "fmt:check": "prettier --check .",
    "//── ANDAMIAJE / SDD ────────────────────────────────": "",
    "new:spec": "node tools/scripts/new-spec.mjs",
    "new:feature": "node tools/scripts/new-feature.mjs",
    "new:module": "node tools/scripts/new-module.mjs",
    "new:flag": "node tools/scripts/new-flag.mjs",
    "//── INTERNOS ───────────────────────────────────────": "",
    "doctor": "node tools/scripts/check-env.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "typescript": "~6.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "angular-eslint": "^22.0.0",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "jsdom": "^27.0.0",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "sass": "^1.93.0",
    "@mapit/config-eslint": "workspace:*",
    "@mapit/config-prettier": "workspace:*",
    "@mapit/config-typescript": "workspace:*"
  },
  "lint-staged": {
    "*.{ts,html,scss,css,json,md,yaml,yml}": "prettier --write",
    "*.ts": "eslint --fix --max-warnings=0"
  },
  "prettier": "@mapit/config-prettier",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  }
}
